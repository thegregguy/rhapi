# ===========================================
# Robinhood API Configuration
# ===========================================
API_KEY=your_robinhood_api_key_here
BASE64_PRIVATE_KEY=your_robinhood_base64_private_key_here

# ===========================================
# Coinbase API Configuration
# ===========================================
CB_API_KEY=your_coinbase_api_key_here
CB_PRIVATE_KEY=your_coinbase_private_key_here

# ===========================================
# Trading Parameters
# ===========================================
# Default amount to spend per buy order (USD)
DEFAULT_BUY_USD=1.00

# Cooldown period between buy orders for the same coin (seconds)
COOLDOWN_SECONDS=600

# Time between trading scans (seconds)
SCAN_INTERVAL=15

# ===========================================
# Performance Settings
# ===========================================
# Enable concurrent processing of coins (true/false)
USE_CONCURRENCY=true

# Maximum number of worker threads for concurrent processing
MAX_WORKERS=4

# ===========================================
# Operational Modes
# ===========================================
# Dry run mode - if true, no real orders will be placed (true/false)
AUTO_DRY_RUN=false

# Debug mode - enables verbose logging (true/false)
DEBUG=false

# ===========================================
# Data Storage
# ===========================================
# Path to portfolio JSON file
PORTFOLIO_FILE=portfolio.json
