# Robinhood API Configuration
API_KEY=your_robinhood_api_key_here
BASE64_PRIVATE_KEY=your_base64_encoded_private_key_here

# Coinbase API Configuration
CB_API_KEY=your_coinbase_api_key_here
CB_PRIVATE_KEY=your_coinbase_private_key_here

# Trading Configuration
DEFAULT_BUY_USD=1.00          # Default buy amount in USD
COOLDOWN=600                   # Cooldown period between buys (seconds)
SCAN_INTERVAL=15               # Time between scans (seconds)
MAX_WORKERS=4                  # Number of concurrent workers for IO operations (0 = sequential)

# Dry Run Mode
AUTO_DRY_RUN=false            # Set to 'true' to prevent real orders (testing mode)

# Logging
DEBUG=false                    # Enable debug logging
LOG_LEVEL=INFO                 # Logging level: DEBUG, INFO, WARNING, ERROR
