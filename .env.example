# Robinhood API Credentials
API_KEY=your_robinhood_api_key_here
BASE64_PRIVATE_KEY=your_base64_encoded_private_key_here

# Coinbase API Credentials
CB_API_KEY=your_coinbase_api_key_here
CB_PRIVATE_KEY=your_coinbase_private_key_here

# Trading Configuration
DEFAULT_BUY_USD=1.00
COOLDOWN=600
SCAN_INTERVAL=15

# Concurrency (number of workers for parallel processing, 0 or 1 for sequential)
MAX_WORKERS=4

# Dry Run Mode (set to true to prevent real orders)
AUTO_DRY_RUN=false

# Debug/Logging
DEBUG=false
LOG_LEVEL=INFO
