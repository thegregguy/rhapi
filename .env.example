# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===========================
# EXCHANGE API CREDENTIALS
# ===========================

# Robinhood API
API_KEY=your_robinhood_api_key_here
BASE64_PRIVATE_KEY=your_base64_encoded_private_key_here

# Coinbase API
CB_API_KEY=your_coinbase_api_key_here
CB_PRIVATE_KEY=your_coinbase_private_key_here

# ===========================
# TRADER CONFIGURATION
# ===========================

# Dollar amount to spend per buy order
AUTO_BUY_USD=1.00

# Cooldown period between buy orders (seconds)
AUTO_COOLDOWN=600

# Time between market scans (seconds)
SCAN_INTERVAL=15

# Number of concurrent worker threads for processing coins
MAX_WORKERS=4

# Enable dry-run mode (no real orders placed)
# Set to 'true', '1', 'yes', or 'on' to enable
AUTO_DRY_RUN=false

# ===========================
# LOGGING CONFIGURATION
# ===========================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode for detailed console output
# Set to 'true', '1', 'yes', or 'on' to enable
DEBUG=false
